import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int[] freq = new int[100];

        for (int i = 0; i < n; i++) {
            int x = sc.nextInt();
            freq[x]++;
        }

        for (int i = 0; i < 100; i++) {
            System.out.print(freq[i] + " ");
        }

        sc.close();
    }
}
