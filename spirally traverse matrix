#include <stdio.h>

int main() {
    int N, M;
    scanf("%d %d", &N, &M);

    long long matrix[N][M];

    for (int i = 0; i < N; i++) {
        for (int j = 0; j < M; j++) {
            scanf("%lld", &matrix[i][j]);
        }
    }

    int top = 0, bottom = N - 1;
    int left = 0, right = M - 1;

    while (top <= bottom && left <= right) {

        // Left to Right across the top row
        for (int j = left; j <= right; j++)
            printf("%lld ", matrix[top][j]);
        top++;

        // Top to Bottom along the right column
        for (int i = top; i <= bottom; i++)
            printf("%lld ", matrix[i][right]);
        right--;

        // Right to Left across the bottom row
        if (top <= bottom) {
            for (int j = right; j >= left; j--)
                printf("%lld ", matrix[bottom][j]);
            bottom--;
        }

        // Bottom to Top along the left column
        if (left <= right) {
            for (int i = bottom; i >= top; i--)
                printf("%lld ", matrix[i][left]);
            left++;
        }
    }

    return 0;
}
