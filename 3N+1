#include <stdio.h>

int cycleLength(long long n) {
    int count = 1;

    while (n != 1) {
        if (n % 2 == 0)
            n = n / 2;
        else
            n = 3 * n + 1;

        count++;
    }

    return count;
}

int main() {
    int i, j;
    scanf("%d %d", &i, &j);

    // Keep original values for output
    int originalI = i;
    int originalJ = j;

    // Swap for processing
    int start = i;
    int end = j;

    if (start > end) {
        int temp = start;
        start = end;
        end = temp;
    }

    int maxCycle = 0;

    for (int n = start; n <= end; n++) {
        int length = cycleLength(n);

        if (length > maxCycle)
            maxCycle = length;
    }

    printf("%d %d %d\n", originalI, originalJ, maxCycle);

    return 0;
}
