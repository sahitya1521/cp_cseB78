#include <stdio.h>

void countingSort(int arr[], int n) {
    int i, max = arr[0];

    // Find maximum value
    for (i = 1; i < n; i++) {
        if (arr[i] > max)
            max = arr[i];
    }

    // Create count array
    int count[max + 1];

    // Initialize count array to 0
    for (i = 0; i <= max; i++) {
        count[i] = 0;
    }

    // Store frequency of each element
    for (i = 0; i < n; i++) {
        count[arr[i]]++;
    }

    // Print sorted array
    for (i = 0; i <= max; i++) {
        while (count[i] > 0) {
            printf("%d ", i);
            count[i]--;
        }
    }
}

int main() {
    int n, i;

    scanf("%d", &n);

    int arr[n];

    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    countingSort(arr, n);

    return 0;
}
