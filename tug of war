#include <stdio.h>
#include <stdlib.h>

int n;
int arr[30];
int total;
int ans = 1000;

void solve(int index, int count, int sum)
{
    if (count == n / 2)
    {
        int diff = abs(total - 2 * sum);

        if (diff < ans)
            ans = diff;

        return;
    }

    if (index == n)
        return;

    for (int i = index; i < n; i++)
    {
        solve(i + 1, count + 1, sum + arr[i]);
    }
}

int main()
{
    scanf("%d", &n);

    total = 0;

    for (int i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
        total += arr[i];
    }

    solve(0, 0, 0);

    printf("%d\n", ans);

    return 0;
}
